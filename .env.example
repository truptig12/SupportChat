# Copy to .env (same folder) and fill in. .env is git-ignored; never commit it.
#   cp .env.example .env
#
# Real environment variables override values here (use that in production).

# --- Required for real LLM routing ------------------------------------------
# Get one at https://platform.openai.com/api-keys
# Leave empty => offline keyword MOCK backend (demos/tests only, English only).
OPENAI_API_KEY=

# --- Required: key the mobile app sends in the X-API-Key header -------------
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# DEV ONLY: see README "Security" — replace with real user auth before prod.
APP_API_KEY=dev-key-change-me

# --- Models (optional) -------------------------------------------------------
OPENAI_MODEL=gpt-4o-mini
# Per-stage overrides (fall back to OPENAI_MODEL):
# OPENAI_CLASSIFY_MODEL=gpt-4o-mini
# OPENAI_RESOLVE_MODEL=gpt-4o
# OPENAI_SUMMARY_MODEL=gpt-4o-mini
# LLM_TIMEOUT_SECONDS=20
# LLM_MAX_RETRIES=2

# --- Storage & memory (optional) ---------------------------------------------
DB_PATH=support_router.db
# SESSION_IDLE_MINUTES=30
# HISTORY_TURNS_IN_CONTEXT=8
# SUMMARIES_IN_CONTEXT=3
# MEMORY_RETENTION_DAYS=180
# REPEAT_CONTACT_THRESHOLD=2
# SWEEP_INTERVAL_SECONDS=300

# --- Routing behaviour (optional) --------------------------------------------
# CLARIFY_BELOW_CONFIDENCE=0.55
# SECONDARY_INTENT_MIN_CONFIDENCE=0.5
# MAX_INTENTS_PER_TURN=3
# MAX_BUTTONS=6

# --- Guardrails (optional) ----------------------------------------------------
# MAX_MESSAGE_CHARS=2000
# RATE_LIMIT_PER_MINUTE=20
# RATE_LIMIT_BURST=5

LOG_LEVEL=INFO
